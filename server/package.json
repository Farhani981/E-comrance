{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "E-Commerce Backend API with Express and MySQL",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:auth": "node --test --test-isolation=none tests/auth.test.js tests/jwtConfig.test.js",
    "test:images": "node --test --test-isolation=none tests/images.test.js",
    "test:images:db": "node --test --test-isolation=none tests/images.integration.test.js",
    "test:pricing": "node --test --test-isolation=none tests/pricing.test.js tests/operations.test.js",
    "test": "node --test tests/*.test.js",
    "test:all:isolated": "node tests/runIsolatedDbTests.js",
    "test:profile": "node --test --test-isolation=none tests/profile.test.js",
    "test:settings": "node --test --test-isolation=none tests/settings.test.js",
    "test:contact": "node --test --test-isolation=none tests/contact.test.js",
    "test:cod": "node --test --test-isolation=none tests/codSettlement.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.0.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
