# Copy to server/.env; supply a private randomly generated JWT signing key.
# Intentionally blank: the server refuses to start without it in every environment.
JWT_SECRET=
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db
FRONTEND_URL=http://localhost:5173
# Optional email notifications configuration
EMAIL_USER=
EMAIL_PASS=
# Stripe keys stay on the server. Use the matching test/live account keys.
STRIPE_SECRET_KEY=
# Configure payment_intent.succeeded deliveries to /api/orders/stripe-webhook.
STRIPE_WEBHOOK_SECRET=
